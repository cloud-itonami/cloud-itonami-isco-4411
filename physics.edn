;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a shelving, sorting and retrieval robot
;; performs book/media reshelving, sorting and hold-shelf retrieval.
;; Declared here: a stack of returned books placed on a high shelf, and the
;; loaded book trolley driven from the returns sorter to the stacks.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4411"
 :cases
 [{:id :book-stack-to-top-shelf
   :kind :manipulator
   :procedure "arm lifts a stack of returned books from the trolley to the top shelf of a bay"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 5.0 :m2-kg 3.5
            :from [0.55 0.10] :to [0.35 1.05] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.5 3.0 5.0 8.0]}
   :quantity :peak-tau1-nm
   :limit {:max 70.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm"}
   :boundary {:lo 0.1 :hi 30.0}}
  {:id :book-trolley-to-stacks
   :kind :transport
   :procedure "robot pushes a loaded book trolley from the returns sorter to the stacks"
   :params {:mass-kg 55.0 :distance-m 45.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.03
            :cog-height-m 0.75 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [20.0 50.0 80.0 110.0 150.0]}
   :quantity :cycle-time-s
   :limit {:max 70.0 :basis "estimate: one sorter-to-stacks leg so returned items are back on the shelf within the library's same-hour reshelving target"}
   :boundary {:lo 5.0 :hi 300.0}}]}
